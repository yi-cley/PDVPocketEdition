# Copie para .env.local (dentro de web/) e preencha. O .env NUNCA vai para o GitHub.
# Valores em: Supabase > Project Settings > API (ou Data API)
# No Vite, só variáveis que começam com VITE_ chegam ao navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# A chave service_role não é usada pelo app e nunca deve aparecer aqui.
